NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-staging-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-staging-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-staging-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-staging-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-staging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-staging-app-id
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=replace-with-staging-recaptcha-enterprise-site-key
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
APP_ENV=staging
GCLOUD_PROJECT=replace-with-staging-project-id
FUNCTIONS_REGION=us-central1
LOG_LEVEL=info
NOTIFICATION_ADAPTER_MODE=log
INTEGRATION_ADAPTER_MODE=noop
WAREHOUSE_APP_CHECK_ENABLED=true
WAREHOUSE_BOOTSTRAP_ENABLED=false
WAREHOUSE_SCHEDULED_FUNCTIONS_ENABLED=true
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=false
PRODUCTION_FIREBASE_PROJECT_ID=replace-with-production-project-id
WAREHOUSE_REQUIRED_SECRETS=WAREHOUSE_BOOTSTRAP_SECRET
# Values for these server-only names belong in Firebase Secret Manager, not this file.
WAREHOUSE_FUTURE_PROVIDER_SECRET_NAMES=replace-with-provider-secret-names-if-enabled
WAREHOUSE_INTEGRATION_SECRET_NAMES=replace-with-integration-secret-names-if-enabled
WAREHOUSE_SIGNING_KEY_SECRET_NAMES=replace-with-signing-key-secret-names-if-enabled
