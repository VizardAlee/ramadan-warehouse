{
  "name": "ramadan-warehouse",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-ramadan-warehouse --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "emulators": "firebase emulators:start --project demo-ramadan-warehouse",
    "functions:build": "tsc -p functions/tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.1",
    "@tailwindcss/postcss": "4.1.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.17.1",
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.3.2",
    "lucide-react": "0.539.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "14.12.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.7",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
