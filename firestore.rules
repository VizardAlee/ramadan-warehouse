rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function active() { return hasProfile() && profile().status == "active"; }
    function sameOrganization(data) { return active() && data.organizationId == profile().organizationId; }
    function hasRole(role) {
      return active() && (
        (profile().keys().hasAny(["roleIds"]) && profile().roleIds is list && role in profile().roleIds) ||
        (!profile().keys().hasAny(["roleIds"]) && profile().roleId == role)
      );
    }
    function canManageFoundation() { return hasRole("system_administrator"); }
    function canManageUsers() { return canManageFoundation() || hasRole("operations_administrator"); }
    function canViewOperations() { return canManageUsers() || hasRole("auditor"); }
    function canAudit() { return hasRole("auditor") || hasRole("system_administrator"); }
    function hasAnyRole(roles) {
      return active() && (
        (profile().keys().hasAny(["roleIds"]) && profile().roleIds is list && profile().roleIds.hasAny(roles)) ||
        (!profile().keys().hasAny(["roleIds"]) && profile().roleId in roles)
      );
    }
    function canReadProducts() { return hasAnyRole(["system_administrator", "operations_administrator", "warehouse_manager", "warehouse_officer", "branch_requester", "branch_manager", "sales_cashier", "finance_officer", "auditor"]); }
    function canReadOrganizationInventory() { return hasAnyRole(["system_administrator", "operations_administrator", "finance_officer", "auditor"]); }
    function hasInventoryCostAccess() { return hasAnyRole(["system_administrator", "warehouse_manager", "finance_officer", "auditor"]); }
    function inventoryScope(data) {
      return canReadOrganizationInventory() ||
        (hasAnyRole(["warehouse_manager", "warehouse_officer"]) && (
          (data.warehouseId != null && data.warehouseId in profile().warehouseIds) ||
          (data.sourceWarehouseId != null && data.sourceWarehouseId in profile().warehouseIds) ||
          (data.destinationWarehouseId != null && data.destinationWarehouseId in profile().warehouseIds)
        )) ||
        (hasRole("branch_manager") && (
          (data.branchId != null && data.branchId in profile().branchIds) ||
          (data.sourceBranchId != null && data.sourceBranchId in profile().branchIds) ||
          (data.destinationBranchId != null && data.destinationBranchId in profile().branchIds)
        ));
    }
    function canReadAllRequests() { return hasAnyRole(["system_administrator", "operations_administrator", "warehouse_manager", "warehouse_officer", "finance_officer", "auditor"]); }
    function requestScope(data) {
      return canReadAllRequests() ||
        (hasAnyRole(["branch_requester", "branch_manager"]) && data.branchId in profile().branchIds);
    }
    function canReadAllTransfers() { return hasAnyRole(["system_administrator", "operations_administrator", "finance_officer", "auditor"]); }
    function hasTransferCostAccess() { return hasAnyRole(["system_administrator", "warehouse_manager", "finance_officer", "auditor"]); }
    function transferScope(data) {
      return canReadAllTransfers() ||
        (hasAnyRole(["warehouse_manager", "warehouse_officer"]) && data.originWarehouseId in profile().warehouseIds) ||
        (hasAnyRole(["branch_requester", "branch_manager"]) && data.destinationBranchId in profile().branchIds);
    }
    function relatedTransfer(data) { return get(/databases/$(database)/documents/transfers/$(data.transferId)).data; }
    function relatedTransferScope(data) { return sameOrganization(data) && transferScope(relatedTransfer(data)); }
    function canReadAllSales() { return hasAnyRole(["system_administrator", "operations_administrator", "finance_officer", "auditor"]); }
    function salesScope(data) {
      return canReadAllSales() ||
        (hasAnyRole(["branch_manager", "sales_cashier"]) && data.branchId in profile().branchIds);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || (canManageUsers() && sameOrganization(resource.data)));
      allow list: if canManageUsers() && sameOrganization(resource.data);
      allow create, update, delete: if false;
    }

    match /organizations/{organizationId} {
      allow get: if active() && organizationId == profile().organizationId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /branches/{documentId} {
      allow read: if sameOrganization(resource.data) && (canViewOperations() || documentId in profile().branchIds);
      allow create, update, delete: if false;
    }

    match /warehouses/{documentId} {
      allow read: if sameOrganization(resource.data) && (canViewOperations() || documentId in profile().warehouseIds);
      allow create, update, delete: if false;
    }

    match /inventoryLocations/{documentId} {
      allow read: if sameOrganization(resource.data) && (
        canViewOperations() ||
        (resource.data.branchId != null && resource.data.branchId in profile().branchIds) ||
        (resource.data.warehouseId != null && resource.data.warehouseId in profile().warehouseIds)
      );
      allow create, update, delete: if false;
    }

    match /roles/{documentId} {
      allow read: if sameOrganization(resource.data) && canManageUsers();
      allow create, update, delete: if false;
    }

    match /auditLogs/{documentId} {
      allow read: if sameOrganization(resource.data) && canAudit();
      allow create, update, delete: if false;
    }

    match /products/{documentId} {
      allow read: if sameOrganization(resource.data) && canReadProducts();
      allow create, update, delete: if false;
    }

    match /productCategories/{documentId} {
      allow read: if sameOrganization(resource.data) && canReadProducts();
      allow create, update, delete: if false;
    }
    match /productCosts/{documentId} {
      allow read: if sameOrganization(resource.data) && hasInventoryCostAccess();
      allow create, update, delete: if false;
    }
    match /productSalesPrices/{documentId} {
      allow read: if sameOrganization(resource.data) && canReadProducts();
      allow create, update, delete: if false;
    }
    match /branchSalesPrices/{documentId} {
      allow read: if sameOrganization(resource.data) && salesScope(resource.data);
      allow create, update, delete: if false;
    }

    match /inventoryTransactions/{documentId} {
      allow read: if sameOrganization(resource.data) && inventoryScope(resource.data);
      allow create, update, delete: if false;
    }

    // These documents contain cost fields. Quantity-only roles use sanitized callables.
    match /inventoryEntries/{documentId} {
      allow read: if sameOrganization(resource.data) && hasInventoryCostAccess() && inventoryScope(resource.data);
      allow create, update, delete: if false;
    }
    match /inventoryBalances/{documentId} {
      allow read: if sameOrganization(resource.data) && hasInventoryCostAccess() && inventoryScope(resource.data);
      allow create, update, delete: if false;
    }
    match /serializedItems/{documentId} {
      allow read: if sameOrganization(resource.data) && hasInventoryCostAccess() && inventoryScope(resource.data);
      allow create, update, delete: if false;
    }
    match /inventoryLots/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "finance_officer", "auditor"]);
      allow create, update, delete: if false;
    }

    match /stockCounts/{documentId} {
      allow read: if sameOrganization(resource.data) && (canReadOrganizationInventory() || request.auth.uid in resource.data.assignedUserIds || inventoryScope(resource.data));
      allow create, update, delete: if false;
    }
    match /stockCountItems/{documentId} {
      allow read: if sameOrganization(resource.data) && exists(/databases/$(database)/documents/stockCounts/$(resource.data.stockCountId)) && (canReadOrganizationInventory() || (request.auth.uid in get(/databases/$(database)/documents/stockCounts/$(resource.data.stockCountId)).data.assignedUserIds && (get(/databases/$(database)/documents/stockCounts/$(resource.data.stockCountId)).data.blindCount != true || get(/databases/$(database)/documents/stockCounts/$(resource.data.stockCountId)).data.status != "in_progress")));
      allow create, update, delete: if false;
    }
    match /inventoryReconciliations/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "operations_administrator", "auditor"]);
      allow create, update, delete: if false;
    }

    match /branchRequests/{documentId} {
      allow read: if sameOrganization(resource.data) && requestScope(resource.data);
      allow create, update, delete: if false;
    }
    match /branchRequestItems/{documentId} {
      allow read: if sameOrganization(resource.data) && requestScope(resource.data);
      allow create, update, delete: if false;
    }
    match /branchRequestVersions/{documentId} {
      allow read: if sameOrganization(resource.data) && requestScope(resource.data);
      allow create, update, delete: if false;
    }
    match /branchRequestEvents/{documentId} {
      allow read: if sameOrganization(resource.data) && requestScope(resource.data);
      allow create, update, delete: if false;
    }
    match /branchRequestApprovals/{documentId} {
      allow read: if sameOrganization(resource.data) && canReadAllRequests();
      allow create, update, delete: if false;
    }
    match /branchRequestComments/{documentId} {
      allow read: if sameOrganization(resource.data) && requestScope(resource.data) &&
        (resource.data.visibility == "branch" || canReadAllRequests());
      allow create, update, delete: if false;
    }
    match /notificationEvents/{documentId} {
      allow read, write: if false;
    }

    // Transfer headers contain cost totals. Quantity-only and branch roles use
    // sanitized callables instead of direct document reads.
    match /transfers/{documentId} {
      allow read: if sameOrganization(resource.data) && transferScope(resource.data) &&
        (hasTransferCostAccess() || hasRole("operations_administrator"));
      allow create, update, delete: if false;
    }
    match /transferItems/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferPackages/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferPackageItems/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferPicks/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferPickItems/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferDispatches/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferReceipts/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferReceiptItems/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferDiscrepancies/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferDiscrepancyItems/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /stockReservations/{documentId} {
      allow read: if relatedTransferScope(resource.data) && hasAnyRole(["system_administrator", "operations_administrator", "warehouse_manager", "warehouse_officer", "auditor"]);
      allow create, update, delete: if false;
    }
    match /transferEvents/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferVersions/{documentId} {
      allow read: if relatedTransferScope(resource.data);
      allow create, update, delete: if false;
    }
    match /transferApprovals/{documentId} {
      allow read: if relatedTransferScope(resource.data) && hasAnyRole(["system_administrator", "operations_administrator", "warehouse_manager", "auditor"]);
      allow create, update, delete: if false;
    }
    match /transferCosts/{documentId} {
      allow read: if relatedTransferScope(resource.data) && hasTransferCostAccess();
      allow create, update, delete: if false;
    }
    match /vehicles/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "operations_administrator", "warehouse_manager", "logistics_officer", "auditor"]);
      allow create, update, delete: if false;
    }
    match /drivers/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "operations_administrator", "warehouse_manager", "logistics_officer", "auditor"]);
      allow create, update, delete: if false;
    }
    match /logisticsVendors/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "operations_administrator", "warehouse_manager", "logistics_officer", "finance_officer", "auditor"]);
      allow create, update, delete: if false;
    }

    match /sales/{documentId} {
      allow read: if sameOrganization(resource.data) && salesScope(resource.data);
      allow create, update, delete: if false;
    }
    match /saleItems/{documentId} {
      allow read: if sameOrganization(resource.data) && salesScope(resource.data);
      allow create, update, delete: if false;
    }
    match /salePayments/{documentId} {
      allow read: if sameOrganization(resource.data) && salesScope(resource.data);
      allow create, update, delete: if false;
    }
    match /salesReceipts/{documentId} {
      allow read: if sameOrganization(resource.data) && salesScope(resource.data);
      allow create, update, delete: if false;
    }
    match /posShifts/{documentId} {
      allow read: if sameOrganization(resource.data) && salesScope(resource.data);
      allow create, update, delete: if false;
    }
    match /chartOfAccounts/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "finance_officer", "auditor"]);
      allow create, update, delete: if false;
    }
    match /journalEntries/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "finance_officer", "auditor"]);
      allow create, update, delete: if false;
    }
    match /journalLines/{documentId} {
      allow read: if sameOrganization(resource.data) && hasAnyRole(["system_administrator", "finance_officer", "auditor"]);
      allow create, update, delete: if false;
    }

    match /system/{documentId} {
      allow read, write: if false;
    }

    // Sensitive and future collections are intentionally covered only by this deny rule.
    // Their mutations will be opened narrowly as server-authoritative phases are added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
