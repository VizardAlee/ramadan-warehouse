{
  "functions": [{ "source": "functions", "codebase": "default", "predeploy": ["npm --prefix functions run build"], "ignore": ["node_modules", ".git", "firebase-debug.log", "*.local"] }],
  "apphosting": {
    "backendId": "ramadan-warehouse-staging",
    "rootDir": ".",
    "alwaysDeployFromSource": true,
    "ignore": ["node_modules", ".git", "firebase-debug.log", "*.local", ".env*"]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8180 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
