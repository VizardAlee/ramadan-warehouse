NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-production-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ramadan-warehouse-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ramadan-warehouse-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ramadan-warehouse-staging.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-production-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-production-app-id
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=replace-with-production-recaptcha-enterprise-site-key
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
APP_ENV=production
GCLOUD_PROJECT=ramadan-warehouse-staging
FUNCTIONS_REGION=us-central1
LOG_LEVEL=info
NOTIFICATION_ADAPTER_MODE=noop
INTEGRATION_ADAPTER_MODE=noop
WAREHOUSE_APP_CHECK_ENABLED=true
WAREHOUSE_BOOTSTRAP_ENABLED=true
WAREHOUSE_SCHEDULED_FUNCTIONS_ENABLED=true
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=false
WAREHOUSE_REQUIRED_SECRETS=WAREHOUSE_BOOTSTRAP_SECRET
